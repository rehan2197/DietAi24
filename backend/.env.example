# Copy this file to .env and fill in real values.

# --- Database ---
# Default (SQLite) works out of the box for local dev/demo, no setup required.
DATABASE_URL=sqlite:///./nutrition.db
# For PostgreSQL in production, use something like:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/food_nutrition

# --- Vector store ---
CHROMA_PERSIST_DIR=./chroma_store
CHROMA_COLLECTION_NAME=ifct_foods

# --- Gemini (Vision AI) ---
# Leave empty to run in mock mode (offline testing via debug_description).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Retrieval ---
RETRIEVAL_TOP_K=5
LOW_CONFIDENCE_THRESHOLD=0.55
